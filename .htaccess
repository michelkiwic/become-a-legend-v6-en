# This pitch is accessible by link, but must not appear in search results.
# Keep the header protection in addition to the HTML robots meta tag.
Header always set X-Robots-Tag "noindex, nofollow"
Options -Indexes
DirectoryIndex index.html

# Redirect HTTP and the bare domain to the agreed public address.
# ACME validation must remain reachable for certificate renewals.
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.become-a-legend\.com$ [NC]
RewriteRule ^ https://www.become-a-legend.com%{REQUEST_URI} [R=301,L]

AddType video/webm .webm
AddType video/mp4 .mp4
AddType font/woff2 .woff2

# HTML and non-versioned media must be revalidated after updates.
Header set Cache-Control "no-cache"
<FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
